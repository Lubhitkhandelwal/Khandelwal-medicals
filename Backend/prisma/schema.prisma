// prisma/schema.prisma
// Run: npx prisma db push   (creates tables from this file)
// Run: npx prisma studio    (visual DB browser at localhost:5555)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  brand        String
  category     String
  description  String?
  mrp          Float                       // Maximum Retail Price
  price        Float                       // Your selling price (discounted)
  stock        Int      @default(0)
  unit         String   @default("strip") // strip / bottle / tube / piece
  imageUrl     String?
  isActive     Boolean  @default(true)
  requiresRx   Boolean  @default(false)   // prescription required — always false for OTC
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems   OrderItem[]

  @@map("products")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())

  orders    Order[]

  @@map("customers")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique  // e.g. KM-20240602-0001 (human readable)
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])

  fulfillment     String      // "delivery" | "pickup"
  deliveryAddress String?     // null for pickup
  paymentMethod   String      // "upi" | "cod" | "card"
  paymentStatus   String      @default("pending")   // pending | paid | failed
  razorpayOrderId String?
  razorpayPaymentId String?

  status          String      @default("placed")
  // placed → confirmed → ready → dispatched → delivered
  // placed → confirmed → ready → picked_up    (for pickup)

  subtotal        Float
  deliveryCharge  Float       @default(0)
  discount        Float       @default(0)
  total           Float

  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName  String  // snapshot at time of order (in case price changes later)
  productBrand String
  mrp          Float
  price        Float
  quantity     Int

  @@map("order_items")
}

model StoreConfig {
  id             String @id @default("store")
  name           String @default("Khandelwal Medicals")
  address        String @default("Khandelwal Medicals, Sonkh Road, Kumher, 321201")
  phone          String @default("6378966072")
  deliveryCharge Float  @default(40)
  minOrderFree   Float  @default(500) // free delivery above this amount
  isOpen         Boolean @default(true)

  @@map("store_config")
}