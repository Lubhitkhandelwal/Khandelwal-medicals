# ─── Database (copy from Supabase dashboard → Settings → Database → Connection string) ───
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Razorpay (get from razorpay.com → Settings → API Keys) ──────────────────
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"

# ─── Admin panel password (set something strong) ─────────────────────────────
ADMIN_PASSWORD="khandelwal@admin123"

# ─── Frontend URL (used for CORS) ─────────────────────────────────────────────
# Local dev:
FRONTEND_URL="http://localhost:3000"
# After deploying frontend, change to your real domain e.g.:
# FRONTEND_URL="https://khandelwalmedicals.in"

# ─── Server port ──────────────────────────────────────────────────────────────
PORT=4000
